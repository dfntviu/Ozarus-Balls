{
  "name": "ozarus-y-balls",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Ozarus & Balls — sitio fan de Dragon Ball migrado a React + TypeScript.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check:contrast": "node scripts/check-contrast.ts",
    "extract": "node scripts/extract-legacy.mjs ../Ozarus-Y.Balls",
    "data:dragon-ball": "node scripts/normalize-saga.ts dragon-ball",
    "data:z": "node scripts/normalize-saga.ts z",
    "data:gt": "node scripts/normalize-saga.ts gt",
    "data:super": "node scripts/normalize-saga.ts super",
    "data": "npm run data:dragon-ball && npm run data:z && npm run data:gt && npm run data:super",
    "images": "node scripts/optimize-images.ts ../Ozarus-Y.Balls"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.50.0",
    "typescript": "^5.6.3",
    "vite": "7.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11"
  },
  "dependencies": {
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-router": "7.18.4",
    "@fontsource/dela-gothic-one": "5.3.0",
    "@fontsource/zen-kaku-gothic-new": "5.3.1"
  }
}
